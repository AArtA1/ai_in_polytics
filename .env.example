# ============================================
# Пример файла с переменными окружения
# ============================================
# Скопируйте этот файл в .env и заполните своими значениями:
# cp env.example .env

# OpenAI API Configuration
# Получите ключ на https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Qdrant Configuration
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_PATH=./qdrant_store
QDRANT_COLLECTION=spravedlivo_ru

# Embedding Model
EMB_MODEL=BAAI/bge-m3

# RAG Settings
TOP_K=6

# LLM Settings
LLM_MODEL=gpt-4o-mini
LLM_TEMP=0.7

# Dialogue system prompt (single file). Absolute or relative path
DIALOGUE_SYSTEM_PROMPT_PATH=dialogue_system_prompt.txt

